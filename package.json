{
  "name": "dsh-code-review",
  "version": "0.3.0",
  "private": true,
  "description": "Independent code review of the files the current session changed, graded P0-P3, with per-finding fix/skip decisions sent back to the session.",
  "license": "MIT",
  "author": "JasonYu-nano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonYu-nano/dsh-code-review.git"
  },
  "homepage": "https://github.com/JasonYu-nano/dsh-code-review#readme",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "code-review"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-connection"]
    }
  }
}
